<vertical spacing="1" horizontal--fit="PreferredSize">
	<checkbox-setting 
		text="Separate Saber Percentage" 
		value="separateSaber" 
		hover-hint="Shows the per-saber no swing loss accuracy percentage" 
		apply-on-change="true"
	/>
	<checkbox-setting 
		text="Exclude dotted chain notes" 
		value="excludeDottedLink" 
		hover-hint="Exclude dotted link (tail) on chain notes from accuracy percentage calculation" 
		apply-on-change="true"
	/>
	<checkbox-setting
		text="Exclude multiplier"
		value="excludeMultiplier"
		hover-hint="Exclude multiplier on swing percentage calculation"
		apply-on-change="true"
	/>
</vertical>